# =============================================================================
# ChatBot Builder SaaS - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env files with real secrets to version control
# =============================================================================

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_NAME="ChatBot Builder"

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://chatbot:STRONG_PASSWORD_HERE@localhost:5432/chatbot_saas

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_SECRET_HERE_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_CHAR_SECRET_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── STRIPE ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Get from: https://dashboard.stripe.com/webhooks
# Endpoint: https://api.yourdomain.com/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Create products in Stripe dashboard, then add price IDs:
STRIPE_PRICE_STARTER=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_GROWTH=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_ENTERPRISE=price_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── AI PROVIDERS ─────────────────────────────────────────────────────────────
# At least one must be configured
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── REDIS (UPSTASH) ──────────────────────────────────────────────────────────
# Get from: https://upstash.com/ (free tier available)
UPSTASH_REDIS_REST_URL=https://XXXXXXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── URLS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
WIDGET_CDN_URL=https://cdn.yourdomain.com
API_URL=https://api.yourdomain.com

# ─── EMAIL (SMTP) ─────────────────────────────────────────────────────────────
# For transactional emails (password reset, notifications)
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=your-postmark-api-token
SMTP_PASS=your-postmark-api-token
FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# ─── SECURITY ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── MONITORING (OPTIONAL) ────────────────────────────────────────────────────
# Sentry for error tracking: https://sentry.io
# SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/xxxxx

# ─── LOG LEVEL ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# =============================================================================
# FRONTEND (.env.local)
# =============================================================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXX
NEXT_PUBLIC_APP_NAME="ChatBot Builder"
NEXT_PUBLIC_WIDGET_CDN_URL=https://cdn.yourdomain.com
